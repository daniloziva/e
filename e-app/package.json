{
  "name": "e-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/functions/*.js",
  "scripts": {
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "azurite": "^3.36.0",
    "eslint": "^10.8.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@azure/functions": "^4.16.2",
    "@azure/storage-blob": "^12.33.0"
  }
}
